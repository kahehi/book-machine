{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "manuscript.schema.json",
  "title": "Manuscript",
  "description": "Manuskript-Artefakt: Vollstaendiger Buchtext mit Seitenstruktur.",
  "type": "object",
  "required": [
    "project_id",
    "run_id",
    "title",
    "language",
    "pages",
    "word_count",
    "quality_score",
    "iteration",
    "created_at",
    "created_by"
  ],
  "properties": {
    "project_id": { "type": "string" },
    "run_id": { "type": "string" },
    "title": { "type": "string" },
    "language": { "type": "string" },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["page_number", "text"],
        "properties": {
          "page_number": { "type": "integer", "minimum": 1 },
          "text": {
            "type": "string",
            "description": "Seitentext (Rohtext ohne Formatierung)",
            "minLength": 1
          },
          "image_prompt_en": {
            "type": "string",
            "description": "Englischer Prompt fuer KI-Bildgenerierung"
          },
          "chapter_ref": {
            "type": ["integer", "null"],
            "description": "Verweis auf Kapitel-Nummer aus Outline"
          }
        }
      }
    },
    "word_count": {
      "type": "integer",
      "description": "Gesamtzahl Woerter",
      "minimum": 0
    },
    "quality_score": {
      "type": "number",
      "description": "Qualitaetsscore (0-100) aus letztem QA-Lauf",
      "minimum": 0,
      "maximum": 100
    },
    "quality_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["category", "severity", "description"],
        "properties": {
          "category": { "type": "string" },
          "severity": { "type": "string", "enum": ["low", "medium", "high"] },
          "description": { "type": "string" },
          "fix_suggestion": { "type": "string" },
          "page_ref": { "type": ["integer", "null"] }
        }
      }
    },
    "iteration": {
      "type": "integer",
      "description": "Bearbeitungsrunde (0 = erste Version)",
      "minimum": 0
    },
    "approved": { "type": "boolean", "default": false },
    "created_at": { "type": "string", "format": "date-time" },
    "created_by": { "type": "string" },
    "approved_at": { "type": ["string", "null"], "format": "date-time" }
  },
  "additionalProperties": false
}
