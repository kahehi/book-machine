# =============================================================================
# Micro-Firma Buchproduktion – Umgebungsvariablen
# Kopiere zu .env und passe an. NIEMALS .env einchecken!
# =============================================================================

# ─── LLM Provider ─────────────────────────────────────────────────────────────
# "mock" (no API key needed) | "anthropic" | "openai"
LLM_PROVIDER=mock

# ─── API Keys (only required when LLM_PROVIDER != "mock") ─────────────────────
ANTHROPIC_API_KEY=your-anthropic-key-here
OPENAI_API_KEY=your-openai-key-here

# ─── Storage (bestehende book-machine) ────────────────────────────────────────
DATA_DIR=./data

# ─── Logging ───────────────────────────────────────────────────────────────────
# "debug" | "info" | "warn" | "error"
LOG_LEVEL=info

# ─── Quality Loop ──────────────────────────────────────────────────────────────
TARGET_SCORE=85
MAX_ITERATIONS=3

# ─── Micro-Firma Docker Stack ─────────────────────────────────────────────────
POLL_INTERVAL=5
MAX_REWORK_CYCLES=3

# Docker Bind-Mount Pfade
COMPANY_DATA_PATH=./company
PROJECTS_DATA_PATH=./workspace/projects

# Web-Server Port (bestehende book-machine)
PORT=3000
